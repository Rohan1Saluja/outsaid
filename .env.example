# Reference only. Do not copy this entire file into apps/web.
# API: copy apps/api/.env.example to apps/api/.env.
# Web: copy apps/web/.env.example to apps/web/.env.local.
# No real credentials belong in Git.

# API runtime: Supabase transaction pooler on port 6543, with TLS.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# Migration operator only: direct connection or session pooler on port 5432.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
PORT=4000
NODE_ENV=development

# Web server/build configuration (not a secret; never NEXT_PUBLIC_).
API_ORIGIN=http://localhost:4000
# Production web uses API_ORIGIN=https://outsaid-api.vercel.app

# Backend only. Exact comma-separated web origins, no trailing slash/wildcards.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required: 64 lowercase hex characters. Never use a committed default.
AUTH_SECRET=
