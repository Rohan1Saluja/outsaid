{
  "name": "@outsaid/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:generate && nest start --watch",
    "build": "pnpm db:generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm db:generate && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "auth:provision": "pnpm build && node dist/cli/provision.js",
    "auth:cleanup": "node dist/cli/cleanup-auth.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@outsaid/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "12.1.3",
    "@outsaid/config": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "typescript": "5.9.3"
  }
}
