# Placeholder only: allows liveness testing; does not provide a working database.
DATABASE_URL="postgresql://outsaid:outsaid@127.0.0.1:5432/outsaid"
DIRECT_URL="postgresql://outsaid:outsaid@127.0.0.1:5432/outsaid"
PORT=4000
NODE_ENV=development
# For Supabase URLs and TLS, see ../../.env.example and docs/deployment.md.

# Backend only. Exact comma-separated web origins, no trailing slash/wildcards.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required: 64 lowercase hex characters. Never use a committed default.
AUTH_SECRET=
